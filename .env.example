# Copy this file to .env (local dev) and fill in real values.
# Never commit .env — only this template is tracked in git.

# ---------------------------------------------------------------------------
# Database (Phase 0 — required now)
# ---------------------------------------------------------------------------
# Postgres connection string. Local dev: `npx prisma dev` or a local Postgres.
# Production: managed Postgres (e.g. Neon) — use the pooled connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/bwf?schema=public"

# ---------------------------------------------------------------------------
# Auth (Phase 2 — required now)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin seed account (Phase 2 — used by `prisma db seed` only, not read at
# runtime). Put the real founder/Super Admin details here before seeding a
# real environment — the checked-in defaults are local-dev-only.
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage (wired up in Phase 3 — for member photos, brochures, media)
# ---------------------------------------------------------------------------
# STORAGE_ACCOUNT_ID=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Transactional email — used now for OTP codes (Phase 2); the full
# transactional-email suite (visitor confirmations, weekly reports, etc.)
# lands in Phase 13. With no provider set, OTP codes log to the server
# console instead of sending — fine for local dev, NOT for anything real.
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Analytics (wired up in Phase 10)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# WhatsApp CTA (Phase 1 — static number, no API integration yet)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_WHATSAPP_NUMBER=
