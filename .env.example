# Copy this file to .env (local dev) and fill in real values.
# Never commit .env — only this template is tracked in git.

# ---------------------------------------------------------------------------
# Database (Phase 0 — required now)
# ---------------------------------------------------------------------------
# Postgres connection string. Local dev: `npx prisma dev` or a local Postgres.
# Production: managed Postgres (e.g. Neon) — use the pooled connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/bwf?schema=public"

# ---------------------------------------------------------------------------
# Auth (wired up in Phase 2 — placeholders for now)
# ---------------------------------------------------------------------------
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Object storage (wired up in Phase 2/3 — for member photos, brochures, media)
# ---------------------------------------------------------------------------
# STORAGE_ACCOUNT_ID=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Transactional email (wired up in Phase 13 — provider must stay swappable)
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# OTP / SMS second factor (wired up in Phase 2, for admin MFA)
# ---------------------------------------------------------------------------
# OTP_PROVIDER=
# OTP_API_KEY=

# ---------------------------------------------------------------------------
# Analytics (wired up in Phase 10)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# WhatsApp CTA (Phase 1 — static number, no API integration yet)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_WHATSAPP_NUMBER=
