# Copy this file to .env (local dev) and fill in real values.
# Never commit .env — only this template is tracked in git.

# ---------------------------------------------------------------------------
# Database (Phase 0 — required now)
# ---------------------------------------------------------------------------
# Postgres connection string. Local dev: `npx prisma dev` or a local Postgres.
# Production: managed Postgres (e.g. Neon) — use the pooled connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/bwf?schema=public"

# ---------------------------------------------------------------------------
# Auth (Phase 2 — required now)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin seed account (Phase 2 — used by `prisma db seed` only, not read at
# runtime). Put the real founder/Super Admin details here before seeding a
# real environment — the checked-in defaults are local-dev-only.
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage (wired up in Phase 3 — for member photos, brochures, media)
# ---------------------------------------------------------------------------
# STORAGE_ACCOUNT_ID=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Transactional email — used for OTP/password-reset codes (Phase 2/13) and
# the full transactional-email suite (visitor confirmations, application
# updates, weekly reports, etc. — Phase 13). With no provider set, emails log
# to the server console instead of sending — fine for local dev, NOT for
# anything real.
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Notifications (Phase 13) — the "business email" brief §49 says must not be
# hardcoded. Admin alerts (new applications, new Ask BWF leads) go here.
# Skipped silently (no email attempt) when unset — same no-dead-feature rule
# as NEXT_PUBLIC_WHATSAPP_NUMBER.
# ---------------------------------------------------------------------------
# NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Cron secret — authenticates the scheduled jobs in vercel.json (Vercel signs
# its own cron requests with this as a Bearer token). Currently drives the
# hourly member meeting-reminder job (/api/cron/meeting-reminders, 2026-10-03);
# with it unset the endpoint refuses every request and no reminders go out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Analytics & SEO (Phase 10)
# ---------------------------------------------------------------------------
# Real public domain — used for canonical URLs, the sitemap, and JSON-LD.
# Domain name itself is still an open decision (docs/ARCHITECTURE.md, needed
# by Phase 14-15); falls back to localhost until it's set.
# NEXT_PUBLIC_SITE_URL=https://buildersworldforum.com
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Search Console site-verification meta tag value (Search Console ->
# Settings -> Ownership verification -> HTML tag -> just the content="..." value).
# NEXT_PUBLIC_GSC_VERIFICATION=

# ---------------------------------------------------------------------------
# WhatsApp CTA (Phase 1 — static number, no API integration yet)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# OpenAI (originally Phase 12's Ask BWF chatbot, since removed — see
# docs/ARCHITECTURE.md's Phase 12 section). Now also powers the Marketing
# Portal's Script Writing AI chat (2026-09-18, src/lib/marketing/openai.ts),
# server-side only — the key is never sent to the browser. Without a key set,
# Script Writing's chat shows an honest "AI is not configured yet" message
# instead of failing silently or pretending to respond.
# OPENAI_CHATBOT_MODEL/OPENAI_SCRIPT_MODEL are optional (default gpt-4o-mini).
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_CHATBOT_MODEL=
# OPENAI_SCRIPT_MODEL=

# ---------------------------------------------------------------------------
# Google Maps (2026-10-03 — member portal "Find Members Nearby")
# ---------------------------------------------------------------------------
# Browser key: enable "Maps JavaScript API" + "Places API (New)" and restrict
# it to this site's HTTP referrers (it is public by nature). Without it the
# search falls back to plain address text matching.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud → Map Management) for the results map's
# markers; falls back to Google's DEMO_MAP_ID.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key with "Geocoding API" enabled — used only by the one-off
# `npx tsx scripts/geocode-members.ts [--apply]` backfill of existing
# members' coordinates. Falls back to the browser key if unset.
# GOOGLE_MAPS_SERVER_API_KEY=
