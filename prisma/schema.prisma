// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 2 — auth / RBAC / admin foundation.
//
// Member, Company, Chapter, Category, and every other business entity from
// the brief's §13 model list belong to their own phases (3+) and are NOT
// added here yet — see docs/PHASES.md. Role rows for CHAPTER_ADMIN and
// MEMBER are seeded now as reference data (the taxonomy is known), but the
// scoping needed to actually enforce "Chapter Admin can only access their
// assigned chapter" (brief §11) is added alongside the Chapter model in
// Phase 3, not guessed at here.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id       String     @id @default(cuid())
  email    String     @unique
  name     String
  password String
  status   UserStatus @default(ACTIVE)

  /// Bumped to invalidate every JWT session already issued to this user
  /// (e.g. on password change or an admin-initiated "sign out everywhere").
  sessionVersion Int @default(0)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  otpChallenges OtpChallenge[]
  auditLogs     AuditLog[]

  /// Set only for a User whose role is MEMBER (brief §12) — the Member
  /// profile this login account belongs to. Nullable because most Users
  /// are admins with no Member row at all.
  memberAccount     Member?
  reviewedRevisions MemberProfileRevision[]
  reviewedArticles  Blog[]

  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  /// Stable machine key — SUPER_ADMIN, CENTRAL_ADMIN, CHAPTER_ADMIN, MEMBER.
  key         String  @unique
  label       String
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  /// e.g. "users:manage", "roles:manage", "audit_log:view".
  key         String  @unique
  label       String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  /// Only meaningful when role.key == "CHAPTER_ADMIN" — the chapter this
  /// assignment is scoped to (brief §11: "Chapter Admin can only access
  /// their assigned chapter"). Null for global roles (Super Admin, Central
  /// Admin). This is the scoping mechanism flagged as deferred to Phase 3
  /// in the Phase 2 notes, now that Chapter exists.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model OtpChallenge {
  id       String @id @default(cuid())
  userId   String
  codeHash String

  /// Room for PASSWORD_RESET etc. later without a new table.
  purpose String @default("LOGIN")

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_challenges")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  /// e.g. "user.login", "user.created", "role.assigned".
  action   String
  entity   String?
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3 — chapters, companies, members, categories.
//
// MemberProfile from the brief's §13 list is deliberately NOT a separate
// table yet — its whole reason to exist is the pending-revision workflow
// for member-submitted edits (§20), which only matters once members can log
// in and edit their own profile (Phase 11). Splitting it out now, before
// that workflow exists, would just be structure with no behavior behind it.
// Profile fields live directly on Member for now; revisit if Phase 11
// needs the split.
// ---------------------------------------------------------------------------

enum ChapterStatus {
  /// Exists in the admin system, not shown publicly, not accepting members
  /// yet — brief §16: "Upcoming chapters may exist internally... without
  /// being publicly displayed."
  DRAFT
  /// User request (2026-09-09) — publicly visible and browsable (chapters
  /// listing, homepage grid, its own detail page), but not yet accepting
  /// members/visitors/applications: shown as "Launching Soon" rather than
  /// hidden like DRAFT. Deliberately excluded from every functional
  /// chapter-selection context (Visit/Apply/Members-filter/Feedback
  /// dropdowns) — only the two public browsing listings + its own detail
  /// page opt into showing it.
  COMING_SOON
  ACTIVE
  ARCHIVED
}

model Chapter {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  location    String?
  status      ChapterStatus @default(DRAFT)

  meetingSchedule String?
  meetingVenue    String?
  meetingAddress  String?
  googleMapsUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            Member[]
  leadership         ChapterLeadership[]
  chapterAdmins      UserRole[]
  testimonials       Testimonial[]
  feedback           Feedback[]
  applications       MembershipApplication[]
  meetings           Meeting[]
  visitors           Visitor[]
  chiefGuests        ChiefGuest[]
  rosterAssignments  RosterAssignment[]
  visitorAttendances VisitorAttendance[]

  @@map("chapters")
}

model Category {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  description          String?
  isActive             Boolean @default(true)
  /// Roster correction (2026-09-15): whether this category can appear in a
  /// generated roster's "Open Categories" section. Separate from `isActive`
  /// — the category master accumulated many near-duplicate/legacy rows
  /// (e.g. "Civil Contractors 2" alongside "Civil Contractor - 2") that are
  /// still legitimately `isActive` (a member may hold one, or an admin may
  /// still want it selectable elsewhere) but shouldn't independently count
  /// as an "open slot" on the printed roster. Defaults true so a newly
  /// created category shows up without extra admin steps; existing rows
  /// were backfilled by cross-referencing real member data and the
  /// reference roster PDFs, not left to the default.
  showInOpenCategories Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          Member[]
  applications     MembershipApplication[]
  visitors         Visitor[]
  rosterSelections Roster[]

  @@map("categories")
}

model Company {
  id          String  @id @default(cuid())
  name        String
  description String?
  website     String?
  logoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]

  @@map("companies")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Member {
  id             String       @id @default(cuid())
  /// Public profile URL: /members/{slug}. Generated from name at creation
  /// (see slugify() in members/actions.ts); stable afterwards even if the
  /// name is later edited, so published links never break.
  slug           String       @unique
  name           String
  designation    String?
  bio            String?
  email          String?
  phone          String?
  status         MemberStatus @default(ACTIVE)
  /// Roster correction (2026-09-15): an ACTIVE member can still be a
  /// non-roster row (seed/test/demo data) — status alone isn't a safe
  /// "should this appear on a printed roster" signal. Defaults true so
  /// every real member keeps appearing without any admin action; flip off
  /// per-member for anything that shouldn't print.
  rosterEligible Boolean      @default(true)

  // --- Public profile content (brief §19) — describes THIS member's own
  // specialisation, which can differ from another member at the same
  // Company (brief §14's example: two reps of one company, different
  // categories/chapters). Deliberately plain text fields, not a normalized
  // sub-schema — "services" etc. are freeform lists an admin types in, not
  // structured data the platform needs to query or filter on individually.
  services        String?
  specialisations String?
  usp             String?
  yearsInBusiness Int?
  areasServed     String?
  certifications  String?
  majorProjects   String?
  clientele       String?

  // --- Contact (public, per brief §19 "Public contact details may be displayed") ---
  whatsapp      String?
  website       String?
  address       String?
  googleMapsUrl String?

  // --- Social (brief §19 — "Other approved links" deferred; add if a real need shows up) ---
  instagramUrl String?
  linkedinUrl  String?
  facebookUrl  String?

  // --- Media — URL fields only until object storage (R2) is wired up; no
  // upload UI yet. videoUrl is expected to be a direct file or an approved
  // Google Drive link per brief §19/§47 (YouTube/Instagram embeds are
  // explicitly disallowed there) — not enforced at the schema level since
  // that's a content-moderation judgment call for whoever fills it in.
  photoUrl    String?
  brochureUrl String?
  videoUrl    String?

  // --- Phase 17 — photo/video galleries, each a JSON array of
  // { url: string, caption?: string }. Same shape/precedent as Blog.faq —
  // an ordered list of small records edited inside this one record's form,
  // not a separate child table (no per-parent relational child-row CRUD
  // exists anywhere else in this schema either).
  photos Json?
  videos Json?

  /// Phase 11 — set once an admin grants this member portal login access
  /// (brief §12: "Members eventually receive login access"). Null until
  /// then; a Member can exist for years with no login, same as it did in
  /// Phases 3-10. Nothing about editing/exclusivity/approval logic depends
  /// on this being set.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId  String
  chapterId  String
  categoryId String

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chapter  Chapter  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The category-exclusivity enforcement (brief §15 — CRITICAL rule).
  /// Set to "{chapterId}:{categoryId}" only while status == ACTIVE, and to
  /// null otherwise (see src/lib/members/slot.ts). Because SQL unique
  /// constraints treat every NULL as distinct, this gives a real database-
  /// level guarantee that at most one ACTIVE member can occupy a given
  /// chapter+category pair — not just a check in application code that a
  /// race condition could slip past. Prisma's schema DSL has no portable
  /// way to express a *partial* unique index directly, so this computed-
  /// column pattern is the standard workaround.
  activeSlotKey String? @unique

  /// Phase 20 Batch 5 — decision #6's manual induction picker: an admin
  /// explicitly picks who invited this member at creation time (also
  /// editable later, to fix a mistake), rather than the induction score
  /// being auto-derived from Visitor-conversion matching (explicitly
  /// rejected — see Consumer/MemberChiefGuest's own header comment for the
  /// full reasoning). Null = no inductor recorded.
  referredByMemberId String?
  referredBy         Member?  @relation("MemberInductions", fields: [referredByMemberId], references: [id], onDelete: SetNull)
  inducted           Member[] @relation("MemberInductions")

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadershipRoles   ChapterLeadership[]
  authorProfile     Author?
  fromApplication   MembershipApplication?
  referredVisitors  Visitor[]               @relation("VisitorReferrals")
  profileRevisions  MemberProfileRevision[]
  submittedArticles Blog[]
  testimonials      Testimonial[]

  // Visitor Management System (2026-09-18)
  invitedVisitorAttendances VisitorAttendance[] @relation("VisitorInvitations")
  convertedFromVisitors     VisitorProfile[]    @relation("VisitorConversions")

  // BWF App in-house build (2026-09-09) — see docs comment above the
  // Referral/ThankYouSlip models below for the full picture.
  referralsGiven        Referral[]            @relation("ReferralGiven")
  referralsReceived     Referral[]            @relation("ReferralReceived")
  thankYouSlipsGiven    ThankYouSlip[]        @relation("ThankYouSlipGiven")
  thankYouSlipsReceived ThankYouSlip[]        @relation("ThankYouSlipReceived")
  oneToOnesRecorded     OneToOne[]            @relation("OneToOneRecordedBy")
  oneToOnesWith         OneToOne[]            @relation("OneToOneWith")
  powerDatesHosted      PowerDate[]           @relation("PowerDateHost")
  powerDatesJoined      PowerDate[]           @relation("PowerDateParticipant")
  conclavesOrganized    Conclave[]            @relation("ConclaveOrganizer")
  conclaveParticipation ConclaveParticipant[] @relation("ConclaveParticipation")
  rosterAssignments     RosterAssignment[]
  rosterScores          RosterScore[]
  consumersBrought      Consumer[]
  chiefGuestsBrought    MemberChiefGuest[]

  // QR Code / Attendance / Payment system (2026-09-17)
  attendances Attendance[]
  payments    Payment[]

  // Phase 14 — Postgres doesn't auto-index FK scalar columns; these three
  // are filtered/counted against constantly (directory search, dashboard
  // metrics, exports, chapter-availability computation).
  @@index([chapterId])
  @@index([categoryId])
  @@index([companyId])
  @@map("members")
}

// ---------------------------------------------------------------------------
// Phase 11 — member login + profile edit approval workflow (brief §12/§20).
//
// MemberProfile is still deliberately not split out (the Phase 3/4 note said
// "revisit if Phase 11 needs the split" — it doesn't). A member-submitted
// edit isn't a second copy of the profile; it's a proposed delta that either
// gets applied to the one real Member row or discarded. Storing it as a JSON
// snapshot of proposed field values (same tradeoff as Blog.faq/
// AuditLog.metadata already made) is simpler than mirroring every editable
// column into a parallel table for content that's rejected as often as
// approved.
// ---------------------------------------------------------------------------

enum MemberProfileRevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberProfileRevision {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Proposed values for the editable-profile-field set (see
  /// src/lib/members/profile-fields.ts) — the same fields an admin can edit
  /// directly, submitted by the member instead and held for review. Never
  /// applied to Member until an admin approves it (brief §20: "Members must
  /// NOT directly publish profile changes").
  changes Json

  status MemberProfileRevisionStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([memberId, status])
  @@map("member_profile_revisions")
}

model ChapterLeadershipRole {
  id    String @id @default(cuid())
  /// e.g. PRESIDENT, VICE_PRESIDENT, SECRETARY, COORDINATOR — admin-
  /// manageable so new role types can be added without a code change
  /// (brief §22: "Do not hardcode leadership roles").
  key   String @unique
  label String

  assignments ChapterLeadership[]

  @@map("chapter_leadership_roles")
}

model ChapterLeadership {
  id        String @id @default(cuid())
  chapterId String
  memberId  String
  roleId    String

  chapter Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  member  Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role    ChapterLeadershipRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  startedAt DateTime @default(now())

  @@unique([chapterId, roleId, memberId])
  @@map("chapter_leadership")
}

// ---------------------------------------------------------------------------
// Phase 5 — blog / content management + SEO/AEO/GEO (brief §28-32).
//
// The member-initiated submission workflow from brief §31 ("member submits
// article") can't be fully wired up until member login exists (Phase 11) —
// Blog.authorId already supports linking a post to a Member-backed Author
// now, so hooking up self-service submission later is additive, not a
// restructure. For this phase, admin creates/edits everything directly.
// ---------------------------------------------------------------------------

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Null on every admin-authored post — set only when a member submitted it
/// (brief §31, backlog #21). Mirrors MemberProfileRevisionStatus's 3-state
/// shape, kept as its own enum rather than reusing that one since a Blog is
/// a real published entity being reviewed, not a JSON delta being applied.
enum BlogSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Author {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  bio      String?
  photoUrl String?

  /// Set when this author IS a BWF member (brief §32) — null for BWF Team,
  /// guest contributors, or agency team authors who aren't members.
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  posts Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

model BlogCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  posts Blog[]

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts Blog[]

  @@map("blog_tags")
}

model Blog {
  id      String     @id @default(cuid())
  title   String
  slug    String     @unique
  excerpt String?
  /// Markdown — rendered server-side via `marked` (src/lib/blog/render.ts).
  /// Trusted admin-authored content; the member-submission path (brief §31,
  /// backlog #21) stays behind admin approval before a post can reach
  /// PUBLISHED, so this never renders unreviewed user input.
  content String
  status  BlogStatus @default(DRAFT)

  /// Brief §31 — set when a member submitted this post; null for every
  /// admin-authored one. `submissionStatus` starts PENDING and only ever
  /// moves forward once (see admin/blogs/actions.ts) — approving is just
  /// the normal edit-and-save flow (brief's "Edited" and "Approved" are the
  /// same code path, same precedent as MemberProfileRevision's review
  /// action), rejecting is its own explicit action.
  submittedByMemberId String?
  submittedByMember   Member?               @relation(fields: [submittedByMemberId], references: [id], onDelete: SetNull)
  submissionStatus    BlogSubmissionStatus?
  reviewedById        String?
  reviewedBy          User?                 @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes         String?
  reviewedAt          DateTime?

  /// FAQ entries for AEO/GEO (brief §29) — [{ question, answer }, ...].
  /// Rendered as an on-page FAQ section and FAQPage structured data.
  faq Json?

  featuredImageUrl String?

  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?

  authorId   String
  categoryId String

  author   Author       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags     BlogTag[]

  scheduledAt DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([submissionStatus])
  @@map("blogs")
}

// ---------------------------------------------------------------------------
// Phase 6 — testimonials + feedback + website content CMS (brief §33/§34/§62).
// Three genuinely different visibility models living in one phase: a
// testimonial is public once approved, feedback is never public (Super
// Admin only, brief §34 is explicit about this), and content blocks are
// always public but only editable by admin — worth keeping straight when
// touching any of these three.
// ---------------------------------------------------------------------------

enum TestimonialType {
  MEMBER
  VISITOR
  CLIENT
  VIDEO
  SUCCESS_STORY
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id      String            @id @default(cuid())
  name    String
  company String?
  role    String?
  content String
  type    TestimonialType   @default(MEMBER)
  status  TestimonialStatus @default(PENDING)

  imageUrl String?
  videoUrl String?
  rating   Int?

  /// True once whoever submitted this agreed to public display — brief §58:
  /// "Do not pre-check consent boxes." Checked at the point of approval, not
  /// just at submission, so admin-entered testimonials must set it deliberately too.
  consent  Boolean @default(false)
  featured Boolean @default(false)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  /// Phase 17 — links a testimonial/success story to the specific Member
  /// it's about, mirroring the existing chapterId/chapter pair exactly.
  /// Nullable: a testimonial can still be chapter-only (or neither) same as
  /// before this field existed.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured])
  @@index([chapterId])
  @@index([memberId])
  @@map("testimonials")
}

enum FeedbackType {
  MEETING
  EVENT
  MANAGEMENT
  GENERAL
}

model Feedback {
  id      String       @id @default(cuid())
  type    FeedbackType @default(GENERAL)
  name    String?
  email   String?
  message String

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("feedback")
}

/// Named, admin-editable copy blocks (brief §62) — deliberately NOT a full
/// page builder ("do NOT make every pixel editable"). Each row is one piece
/// of copy identified by a stable key (e.g. "about.intro",
/// "contact.phone") that a page reads at render time instead of hardcoding
/// the string. `section` is purely for grouping the admin UI.
model WebsiteContent {
  key     String  @id
  label   String
  section String
  value   String?

  updatedAt DateTime @updatedAt

  @@map("website_content")
}

model SiteFaq {
  id       String  @id @default(cuid())
  question String
  answer   String
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_faqs")
}

// ---------------------------------------------------------------------------
// Phase 7 — membership application + category availability + waiting list
// (brief §16-17). The applicant's company doesn't exist as a Company record
// yet at submission time — companyName is plain text here, and a real
// Company row only gets created/matched when admin converts an approved
// application into a Member (see applications/actions.ts).
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  MEETING_SCHEDULED
  APPROVED_IN_PRINCIPLE
  WAITING_FOR_PAYMENT
  PAID
  REJECTED
  WAITLISTED
}

model MembershipApplication {
  id              String            @id @default(cuid())
  name            String
  phone           String
  email           String
  companyName     String
  designation     String?
  yearsInBusiness Int?
  referralSource  String?
  companyInfo     String?
  status          ApplicationStatus @default(NEW)

  /// User request (2026-09-09) — membership payment proof, same optional
  /// "verify after, don't hard-gate submission" pattern as Visitor's own
  /// paymentScreenshotUrl.
  paymentScreenshotUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Null when the applicant joined the waiting list because every active
  /// chapter's slot for their category was already taken (brief §16) — an
  /// admin assigns a chapter (possibly a DRAFT one not yet public) once one
  /// opens up, via the application's own admin page.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  /// Set once an admin creates the real Member record (brief §17 step 7 —
  /// approval alone must never auto-create a public member). Keeps the
  /// Visitor → Applicant → Member lineage the brief asks for (§23) visible
  /// from the application side too.
  convertedMemberId String? @unique
  convertedMember   Member? @relation(fields: [convertedMemberId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([categoryId])
  @@map("membership_applications")
}

// ---------------------------------------------------------------------------
// Phase 8 — visitor registration + meetings + events (brief §21/§23-26).
//
// Visitor and VisitorRegistration are listed as separate entities in the
// brief's §13 model list, but every field brief §23 actually asks a visitor
// to submit — name/phone/email/company/category/chapter/meeting/referring
// member — IS the registration. Splitting "person" from "one specific
// registration" only earns its cost once the same person visits more than
// once and that history needs to be reconciled, which isn't asked for yet.
// One Visitor row per registration, same simplicity call as Member vs
// MemberProfile in Phase 3 — revisit if repeat-visitor deduplication
// becomes a real requirement.
// ---------------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id    String @id @default(cuid())
  title String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  startsAt      DateTime
  venue         String?
  address       String?
  googleMapsUrl String?
  agenda        String?
  description   String?

  /// Replaces the old free-text "speaker" field (client correction,
  /// 2026-09-15) — points at the same Chief Guest catalog already used for
  /// the homepage carousel and Roster Sheet PDFs, instead of a plain name
  /// with no photo/company/designation.
  chiefGuestId String?
  chiefGuest   ChiefGuest? @relation(fields: [chiefGuestId], references: [id], onDelete: SetNull)

  visitorRegistrationEnabled Boolean       @default(true)
  status                     MeetingStatus @default(SCHEDULED)

  /// QR Code / Attendance / Payment system (client spec, 2026-09-17).
  /// Generated once on first visit to the QR Code Generation page and never
  /// regenerated afterward ("reopening the meeting displays its existing QR
  /// rather than creating a new one") — see src/lib/attendance/qr.ts. Null
  /// until then.
  attendanceQrToken String? @unique

  /// Admin Open/Close control (independent of the scheduled window below —
  /// an admin can close check-in early or reopen it, same "explicit toggle
  /// plus optional schedule" shape as Meeting.visitorRegistrationEnabled).
  attendanceRegistrationOpen Boolean   @default(false)
  checkInOpensAt             DateTime?
  checkInClosesAt            DateTime?

  /// Visitor Management System (client spec, 2026-09-18) — a second,
  /// independent QR token/toggle pair for walk-in visitor check-in, kept
  /// deliberately distinct from attendanceQrToken/attendanceRegistrationOpen
  /// above (which are member-only) and from visitorRegistrationEnabled above
  /// (which belongs to the unrelated Phase 8 pre-meeting /visit interest
  /// form). See the VisitorAttendance model block for the full rationale.
  visitorAttendanceQrToken String? @unique
  visitorCheckInOpen       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitors           Visitor[]
  roster             Roster?
  attendances        Attendance[]
  payments           Payment[]
  visitorAttendances VisitorAttendance[]
  invitation         MeetingInvitation?

  @@index([chapterId, startsAt])
  @@map("meetings")
}

// ---------------------------------------------------------------------------
// Meeting Invitation Generator (client spec, 2026-09-18). A separate,
// invitation-specific copy of the fields an admin wants on the poster — never
// writes back to Meeting/ChiefGuest, same "customise without modifying the
// original record" rule Phase 22's Attendance/Payment pair already follows.
// dateLabel/timeLabel/venueLabel/addressLabel/feeLabel are deliberately plain
// manual text (confirmed with the user): Meeting has no end-time field and no
// meeting ever had a fee field to begin with, so there is nothing to "auto
// fetch" for those — the admin types them fresh per invitation, same as the
// spec's own "if information is missing, allow manual entry" fallback.
// ---------------------------------------------------------------------------

model MeetingInvitation {
  id String @id @default(cuid())

  meetingId String  @unique
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  headingLine1 String @default("BUILDERS WORLD FORUM")
  headingLine2 String @default("YOU ARE INVITED")

  /// Copied from ChiefGuest at first save, then independently editable —
  /// never written back to the ChiefGuest catalog row.
  guestName         String?
  guestDesignation  String?
  guestOrganisation String?
  guestPhotoUrl     String?

  whyAttendText String @default("Connect with entrepreneurs, build meaningful business relationships, exchange referrals and discover new opportunities through the Builders World Forum.")

  /// Manual-only — see the model-block comment above.
  dateLabel       String?
  timeLabel       String?
  venueLabel      String?
  addressLabel    String?
  feeLabel        String?
  isComplimentary Boolean @default(false)

  includeQr Boolean @default(true)

  /// Snapshot of Meeting.updatedAt at last save/refresh — lets the page
  /// detect "the underlying meeting changed since this invitation was last
  /// saved" (spec: offer a refresh rather than silently going stale).
  meetingSnapshotAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meeting_invitations")
}

enum VisitorStatus {
  REGISTERED
  ATTENDED
  FOLLOW_UP_REQUIRED
  INTERESTED_IN_MEMBERSHIP
  APPLICATION_SUBMITTED
  CONVERTED
  NOT_INTERESTED
}

enum VisitorPurpose {
  PROSPECTIVE_MEMBER
  END_CONSUMER
  CHIEF_GUEST
}

enum VisitorMeetingOption {
  MEETING_ONLY
  MEETING_BREAKFAST
}

model Visitor {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String
  company     String?
  designation String?
  status      VisitorStatus @default(REGISTERED)

  /// Client correction spec (2026-09-09) §40 — visitor pricing/purpose is
  /// specifically about chapter meetings.
  purposeOfVisit       VisitorPurpose?
  meetingOption        VisitorMeetingOption?
  /// R2 URL of the visitor's uploaded payment screenshot — optional (§41's
  /// confirmation copy says "our team will verify your registration and
  /// payment", i.e. verification happens after, not a hard submit gate).
  paymentScreenshotUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  /// Visitors are NOT required to belong to an open category (brief §23),
  /// so unlike Member there is no activeSlotKey / exclusivity check here.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  referringMemberId String?
  referringMember   Member? @relation("VisitorReferrals", fields: [referringMemberId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([categoryId])
  @@map("visitors")
}

// ---------------------------------------------------------------------------
// QR Code / Attendance / Payment system (client implementation spec,
// 2026-09-17) — supersedes the earlier attendance-only instructions.
// Attendance and payment are deliberately two independent record types
// linked to the same Member + Meeting, never one derived from the other:
// approving/rejecting a payment must never change attendance, and a member
// who declines to report a payment is still marked Present. Reuses the
// existing Meeting/Member catalog from the Roster Sheet module rather than
// introducing a parallel registration concept.
//
// Identity/verification note (deliberate deviation from the spec's literal
// "searchable dropdown of members in that chapter" wording): the spec also
// requires "existing member login... choosing a name alone is insufficient."
// Rather than building a second, weaker verification mechanism alongside the
// dropdown, check-in requires the member's existing member-portal login
// (Phase 11) — the logged-in session directly identifies the member (name,
// category, chapter all read from their own Member row), so there is no
// name-picking step at all. See src/app/member/(portal)/checkin/[token]/.
// A member with no portal login yet cannot self-check-in via QR; an admin
// can still mark them Present/Absent directly from Attendance Management.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id String @id @default(cuid())

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status      AttendanceStatus
  checkedInAt DateTime?

  /// Set only when an admin corrects a status after the fact (spec:
  /// "Authorised admins may correct attendance with a mandatory reason and
  /// audit log recording who changed what and when"). The full trail lives
  /// in AuditLog via logActivity(); these are the fast "was this corrected"
  /// fields the Attendance Management table reads without an extra join.
  correctedByUserId String?
  correctionReason  String?
  correctedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  /// Enforces "one attendance record per member per meeting" at the
  /// database level, not just in application code.
  @@unique([meetingId, memberId])
  @@index([memberId])
  @@map("attendances")
}

enum PaymentApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
}

model Payment {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// The Attendance row this was submitted alongside, when known — nullable
  /// because the spec explicitly allows a payment submitted later, after
  /// attendance already exists on its own ("allow a later payment submission
  /// without creating duplicate attendance"). Never the reverse: a payment
  /// never creates or implies an attendance record.
  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  numberOfMonths    Int
  /// [{ month: 1-12, year: number }, ...], length === numberOfMonths,
  /// validated at the point of writing — same Json-plus-app-level-validation
  /// tradeoff as Blog.faq/AuditLog.metadata. Months need not be consecutive.
  monthsCovered     Json
  amountPaidInr     Decimal  @db.Decimal(10, 2)
  actualPaymentDate DateTime

  /// R2 URL — screenshot, receipt image, or PDF (see MEDIA_KINDS.paymentProof
  /// in src/lib/storage.ts).
  proofUrl String

  status           PaymentApprovalStatus @default(PENDING_APPROVAL)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewRemarks    String?

  /// True if, at submission time, any covered month overlapped an already-
  /// APPROVED payment's coverage for this member — surfaced for review, never
  /// auto-rejected (spec: "do not automatically reject legitimate
  /// adjustments").
  overlapsApprovedCoverage Boolean @default(false)

  /// Client-generated once per form render (crypto.randomUUID()) so a
  /// double-click or a retried request is recognized as the same attempt
  /// instead of creating a second transaction (spec: "Prevent duplicate
  /// payment submissions caused by repeated clicks or retries").
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([meetingId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Visitor Management System (client spec, 2026-09-18) — QR-based walk-in
// visitor check-in and payment, mirroring the member Attendance/Payment
// system above but deliberately NOT reusing the Visitor model further up
// this schema. Visitor (Phase 8) is a pre-meeting interest/funnel record
// from the public /visit form (required categoryId, a conversion-funnel
// status enum) — a genuinely different concept from "someone who scanned a
// QR at the meeting and checked in," per the spec's own "keep visitor
// records separate from member records." VisitorProfile is the reusable
// identity (deduped by phone, a verified identifier — never by name alone,
// per the spec); VisitorAttendance is one row per profile-at-one-meeting,
// and — since the QR opens the registration form directly with no separate
// advance-registration step yet — submitting that form *is* the check-in,
// not a two-step process. VisitorPayment is deliberately simpler than
// Payment (no monthsCovered/numberOfMonths): the spec explicitly says "no
// subscription-month selector is needed for visitor meeting fees."
// ---------------------------------------------------------------------------

model VisitorProfile {
  id   String @id @default(cuid())
  name String

  /// Verified dedup identifier (spec: "recognise returning visitors using
  /// verified identifiers; never merge people by name alone"). Not a unique
  /// constraint — a phone number could in principle recur across genuinely
  /// different people — lookup-and-reuse is done in application code.
  phone String

  email            String?
  companyName      String?
  /// Free text ("business category or profession") — distinct from the
  /// Category model, which is membership-category and doesn't apply to
  /// visitors.
  businessCategory String?
  description      String?

  /// Set only via an explicit admin "Link to Member" action (Visitors
  /// Attendance → profile history) once a visitor actually joins as a
  /// member — never auto-matched, since a wrong guess would silently
  /// mislink two different people's histories.
  convertedMemberId String?
  convertedMember   Member? @relation("VisitorConversions", fields: [convertedMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances VisitorAttendance[]

  @@index([phone])
  @@map("visitor_profiles")
}

enum VisitorSource {
  INVITED_BY_MEMBER
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  GOOGLE_SEARCH
  WHATSAPP
  REFERRAL
  OTHER
}

model VisitorAttendance {
  id String @id @default(cuid())

  visitorProfileId String
  visitorProfile   VisitorProfile @relation(fields: [visitorProfileId], references: [id], onDelete: Cascade)

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Denormalized from the meeting at creation time — same convenience the
  /// existing Visitor model already uses for chapter-scoped filtering.
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  source        VisitorSource
  /// Populated for OTHER (spec: "allow source details"); also usable as a
  /// free-text note for any other source if ever needed.
  sourceDetails String?

  invitingMemberId String?
  invitingMember   Member? @relation("VisitorInvitations", fields: [invitingMemberId], references: [id], onDelete: SetNull)

  /// Submitting the public form is itself the check-in (no separate
  /// advance-registration step exists yet) — status starts PRESENT.
  status      AttendanceStatus @default(PRESENT)
  checkedInAt DateTime?

  /// Manual-correction audit fields — same shape as Attendance above, same
  /// "authorised admins may correct with a mandatory reason" requirement.
  correctedByUserId String?
  correctionReason  String?
  correctedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment VisitorPayment?

  /// "Prevent duplicate attendance for the same visitor and meeting" —
  /// enforced at the database level, same as Attendance's own constraint.
  @@unique([meetingId, visitorProfileId])
  @@index([visitorProfileId])
  @@index([chapterId])
  @@map("visitor_attendances")
}

model VisitorPayment {
  id String @id @default(cuid())

  /// Always created alongside a VisitorAttendance in the same submission —
  /// unlike the member Payment model, a visitor payment is never declared
  /// independently of the visit it happened during.
  visitorAttendanceId String            @unique
  visitorAttendance   VisitorAttendance @relation(fields: [visitorAttendanceId], references: [id], onDelete: Cascade)

  amountInr         Decimal  @db.Decimal(10, 2)
  actualPaymentDate DateTime

  /// R2 URL — screenshot, receipt image, or PDF (MEDIA_KINDS.paymentProof).
  proofUrl String

  status           PaymentApprovalStatus @default(PENDING_APPROVAL)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewRemarks    String?

  /// Same double-submit guard as Payment.idempotencyKey.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("visitor_payments")
}

// ---------------------------------------------------------------------------
// Phase 14 — production security review (brief §55): rate limiting / form
// abuse protection. Postgres-backed rather than a new external service
// (Upstash/Redis would need real credentials this project doesn't have) —
// see src/lib/rate-limit.ts. Every FK index added elsewhere in this schema
// this phase (Member/Visitor/MembershipApplication/Blog/Event/Testimonial)
// is also part of this phase, not called out with its own block since it's
// additive to existing models rather than new ones.
// ---------------------------------------------------------------------------

model RateLimitHit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_hits")
}

// ---------------------------------------------------------------------------
// Client correction spec (2026-09-09) — "ADDITIONAL REQUIREMENT — CHIEF
// GUESTS" + backlog #21 ("give Leads-style Chief Guest DB an actual home").
// No fixed limit on how many can be added (spec is explicit about this) —
// plain unbounded table + pagination-free carousel query is enough at any
// realistic scale for a chapter-based community.
// ---------------------------------------------------------------------------

model ChiefGuest {
  id          String  @id @default(cuid())
  name        String
  photoUrl    String?
  company     String?
  designation String?
  description String?

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  visitedAt DateTime?

  isPublished Boolean @default(true)

  /// Explicit admin-set position (spec: "Display Order — Admin configurable").
  /// Null means "let recency decide" — see the homepage carousel's query:
  /// `orderBy: [{ displayOrder: "asc" }, { visitedAt: "desc" }, { createdAt: "desc" }]`.
  /// Rows with a real number sort first (Prisma puts NULLs last in `asc`
  /// order by default), everything else falls back to "most recently
  /// visited first" per the spec's own default-order rule, with no extra
  /// code needed to keep newly-added guests floating to the top.
  displayOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings Meeting[]
  rosters  Roster[]

  @@index([chapterId])
  @@index([isPublished])
  @@map("chief_guests")
}

// ---------------------------------------------------------------------------
// BWF App in-house build (2026-09-09, greenlit after the client corrections
// pass — see memory note [[bwf-app-inhouse]]). Foundation piece: Referral +
// Thank You Slip, the two activity types every later piece (points, weekly/
// periodic reports, detailed reports) aggregates over. Terminology and
// meaning must stay exactly what's already live on /chapters (client
// correction spec's own BWF Terminology section) — do not invent different
// definitions here.
//
// Both models are member-self-reported activity logs, written directly by
// the recording member — deliberately NOT routed through an admin-approval
// queue the way MemberProfileRevision/Blog submissions are. A referral or
// Thank You Slip is a private business record between two members, not
// public-facing content a moderator needs to gate.
// ---------------------------------------------------------------------------

enum ReferralType {
  /// You connect another BWF member with someone from your own network.
  OUTSIDE
  /// You personally buy the other member's product/service.
  SELF
}

model Referral {
  id          String       @id @default(cuid())
  type        ReferralType
  description String?

  /// The member who gave/passed the referral.
  fromMemberId String
  fromMember   Member @relation("ReferralGiven", fields: [fromMemberId], references: [id], onDelete: Restrict)

  /// The member the referral/opportunity was passed to.
  toMemberId String
  toMember   Member @relation("ReferralReceived", fields: [toMemberId], references: [id], onDelete: Restrict)

  thankYouSlips ThankYouSlip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("referrals")
}

/// Records business successfully generated from a referral (brief's own
/// example: Member A refers Member B to HR Groups; HR Groups places a real
/// order with Member B; Member B — the one who actually received the
/// business — records a Thank You Slip TO Member A, the referral's giver).
model ThankYouSlip {
  id          String  @id @default(cuid())
  /// Plain rupee integer, same "store the real number, format at render
  /// time" convention as WebsiteContent's stats.businessGeneratedInr.
  amountInr   Int
  description String?

  /// The member recording this — who received the business and is thanking
  /// the referral's giver.
  fromMemberId String
  fromMember   Member @relation("ThankYouSlipGiven", fields: [fromMemberId], references: [id], onDelete: Restrict)

  /// The member being thanked — who gave the original referral.
  toMemberId String
  toMember   Member @relation("ThankYouSlipReceived", fields: [toMemberId], references: [id], onDelete: Restrict)

  /// Optional link back to the Referral this business came from — not
  /// required, since a member might record a Thank You Slip for older
  /// activity that predates this system.
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([referralId])
  @@map("thank_you_slips")
}

// ---------------------------------------------------------------------------
// BWF App in-house build, continued — One-to-One, Power Date, Conclave.
// Same member-self-reported (no admin-approval queue), same terminology as
// what's already live on /chapters — do not redefine these.
// ---------------------------------------------------------------------------

/// Two BWF members meeting to understand each other deeply — symmetric (no
/// direction, unlike Referral/ThankYouSlip), so `memberId` is just whoever
/// recorded it and `withMemberId` the other person, not a "from/to" of value.
model OneToOne {
  id    String   @id @default(cuid())
  notes String?
  metAt DateTime @default(now())

  memberId String
  member   Member @relation("OneToOneRecordedBy", fields: [memberId], references: [id], onDelete: Restrict)

  withMemberId String
  withMember   Member @relation("OneToOneWith", fields: [withMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([withMemberId])
  @@map("one_to_ones")
}

/// A BWF member (the host) takes one fellow member to meet the host's own
/// external connection. "One or more fellow members" per the brief — taking
/// several companions to the same external meeting is recorded as one
/// PowerDate row per companion, same simplification tradeoff as Member vs
/// MemberProfile (no join table for what's realistically almost always 1).
model PowerDate {
  id                     String   @id @default(cuid())
  externalContactName    String
  externalContactCompany String?
  notes                  String?
  metAt                  DateTime @default(now())

  hostMemberId String
  hostMember   Member @relation("PowerDateHost", fields: [hostMemberId], references: [id], onDelete: Restrict)

  participantMemberId String
  participantMember   Member @relation("PowerDateParticipant", fields: [participantMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostMemberId])
  @@index([participantMemberId])
  @@map("power_dates")
}

// ---------------------------------------------------------------------------
// Phase 20 Batch 5 — Consumer and MemberChiefGuest. ActivityType already had
// CONSUMER/CHIEF_GUEST as distinct point-earning types, but both were
// derived from the public Visitor model's `purposeOfVisit` — the same
// "automatic matching" pattern the client explicitly rejected for induction
// (decision #6: manual only, no auto-derivation from Visitor records). Both
// become real member-self-reported logs instead, the same shape as
// PowerDate's external-contact pattern above — the other party never needs
// to have gone through the public /visit registration flow at all, which
// stays completely untouched by this change (it serves a different concern:
// a walk-in/prebooking visitor's own registration + pricing, not member
// scoring). MemberChiefGuest is deliberately a different model from the
// public ChiefGuest homepage-showcase model below — one is a member's
// private activity record, the other curated public social proof.
// ---------------------------------------------------------------------------

/// A BWF member brought an end consumer (someone with a real construction
/// requirement, not a prospective member) to a meeting.
model Consumer {
  id      String   @id @default(cuid())
  name    String
  company String?
  phone   String?
  notes   String?
  metAt   DateTime @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("consumers")
}

/// A BWF member invited a Chief Guest (a business leader / decision-maker)
/// to a meeting — the member's own activity credit for doing so, separate
/// from the public ChiefGuest homepage carousel (which an admin curates
/// independently, not necessarily 1:1 with these).
model MemberChiefGuest {
  id          String   @id @default(cuid())
  name        String
  company     String?
  designation String?
  notes       String?
  metAt       DateTime @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("member_chief_guests")
}

/// 3+ BWF members meeting together — genuinely needs a real participant
/// list (unlike PowerDate's near-always-one companion), so this gets an
/// actual join table rather than a JSON array: points/reports later need to
/// query "every Conclave a given member was part of" relationally, which a
/// JSON array of ids can't do cleanly (no Prisma include/filter on it).
model Conclave {
  id       String   @id @default(cuid())
  location String?
  notes    String?
  metAt    DateTime @default(now())

  organizedByMemberId String
  organizedByMember   Member @relation("ConclaveOrganizer", fields: [organizedByMemberId], references: [id], onDelete: Restrict)

  participants ConclaveParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizedByMemberId])
  @@map("conclaves")
}

model ConclaveParticipant {
  id String @id @default(cuid())

  conclaveId String
  conclave   Conclave @relation(fields: [conclaveId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation("ConclaveParticipation", fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([conclaveId, memberId])
  @@index([memberId])
  @@map("conclave_participants")
}

// ---------------------------------------------------------------------------
// BWF App in-house build, continued — Points/Scoring (client correction
// spec's "Screenshot 4"). Spec is explicit: "the points allocated to each
// activity must be admin-configurable... do not hard-code the scoring
// values." One row per activity type, seeded at 0 (not fabricated point
// values) — admin sets real numbers via /admin/points-config.
//
// Covers every activity type this app can currently compute for real: the 5
// self-reported models above, plus VISITOR (still derived from the public
// Visitor model's referringMemberId — a prospective-member visitor
// genuinely is that), and CONSUMER/CHIEF_GUEST/INDUCTION — as of Phase 20
// Batch 5, these three are derived from Consumer/MemberChiefGuest
// (self-reported, see their own header comment) and Member.referredByMemberId
// (decision #6's manual picker), not from Visitor at all anymore. Spec's
// remaining list items ("Meeting participation", "Members referred") have no
// underlying data model yet (no attendance-tracking system exists) —
// deliberately left out rather than computed from nothing.
// ---------------------------------------------------------------------------

enum ActivityType {
  REFERRAL
  THANK_YOU_SLIP
  ONE_TO_ONE
  POWER_DATE
  CONCLAVE
  VISITOR
  CONSUMER
  CHIEF_GUEST
  INDUCTION
}

model PointsConfig {
  id           String       @id @default(cuid())
  activityType ActivityType @unique
  points       Int          @default(0)

  updatedAt DateTime @updatedAt

  @@map("points_config")
}

// ---------------------------------------------------------------------------
// Phase 20 Batch 3 — Roster Sheet PDF module. "Meeting Roles" (Power Date
// Host, Visitor Host, Digital Host, etc.) are the reference roster PDFs'
// per-meeting duty-rotation assignments — deliberately NOT modeled as
// ChapterLeadership, which the public /chapters/[slug] page renders in full
// under a "Leadership" heading (see prisma/seed-members.ts's own header
// comment for why that would be wrong here: these are week-to-week
// facilitation duties, not standing chapter offices). Kept as current
// per-chapter state (like ChapterLeadership already is), not a historical
// log per meeting — admin reassigns a duty whenever it rotates, and every
// roster generated after that reflects the new assignment.
// ---------------------------------------------------------------------------

model RosterRole {
  id    String @id @default(cuid())
  /// Admin-extensible, same "do not hardcode roles" pattern as
  /// ChapterLeadershipRole — seeded with a canonical catalog consolidating
  /// the 3 reference chapters' slightly different wording for the same
  /// duties (e.g. "Digital Host" / "Digital Marketing Coordinator").
  key   String @unique
  label String
  order Int    @default(0)

  assignments RosterAssignment[]

  @@map("roster_roles")
}

/// Roster PDF correction (2026-09-15): the reference roster's Coordinators
/// page groups assignments into three columns — President / Secretary /
/// Treasurer Associates — but the same RosterRole (e.g. "Meeting
/// Coordinator") shows up under different columns across the 3 reference
/// chapters, so the column can't be derived from the role. An admin picks it
/// explicitly per assignment instead.
enum RosterAssociateGroup {
  PRESIDENT
  SECRETARY
  TREASURER
}

model RosterAssignment {
  id        String               @id @default(cuid())
  chapterId String
  roleId    String
  memberId  String
  group     RosterAssociateGroup

  chapter Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role    RosterRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  member  Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// A role can have more than one member (the reference PDFs show e.g. two
  /// people both as "Power Date Host") — this only prevents the exact same
  /// member being assigned to the exact same role twice.
  @@unique([chapterId, roleId, memberId])
  @@index([chapterId])
  @@map("roster_assignments")
}

// ---------------------------------------------------------------------------
// Roster Sheet interactive management (2026-09-16 client correction) — the
// Roster Sheet page stops being a stateless "compute a PDF live" generator
// and becomes a real per-Meeting record: scores, automatic ranking, which
// open categories to print, and whether the Notes column is shown are all
// saved here, editable across sessions, and read back verbatim by
// generate.ts when the PDF is downloaded. One Roster per Meeting.
// ---------------------------------------------------------------------------

model Roster {
  id        String  @id @default(cuid())
  meetingId String  @unique
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Section 6 of the correction brief — a single on/off column toggle, not
  /// per-member note text (Give/Ask/Notes are all blank fill-in-by-hand
  /// space on the printed sheet, same as every reference roster).
  notesEnabled Boolean @default(false)

  /// Which Chief Guest(s) are featured on this specific roster's cover —
  /// independent of Meeting.chiefGuestId (that field is the single speaker
  /// shown on the public meeting/visit page; a roster cover can feature more
  /// than one guest, matching the Chapter 1 reference's two-guest cover).
  chiefGuests ChiefGuest[]

  /// The admin-curated subset of this chapter's currently-open categories to
  /// print on this specific roster — defaults to the full open set when a
  /// roster is first opened (src/lib/roster/manage.ts), then admin-editable
  /// per meeting from there.
  openCategories Category[]

  scores RosterScore[]

  /// Null until the admin explicitly clicks "Save Roster" — the wizard
  /// distinguishes "opened but never saved" (Download PDF stays disabled)
  /// from a genuinely saved roster.
  savedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("rosters")
}

/// One row per (Roster, Member) in the roster's "All Other Members" section
/// — Chief Guest/Founding Team/Leadership Team/Coordinators are NOT scored
/// (see src/lib/roster/manage.ts's exclusion logic; those sections keep
/// their existing fixed/catalog order, unaffected by score).
model RosterScore {
  id       String @id @default(cuid())
  rosterId String
  memberId String

  /// Editable by the admin; drives the automatic ranking on Save.
  score Int @default(0)

  /// Recomputed on every Save — a stable descending sort by score (ties
  /// keep their prior relative order) — and used directly as this member's
  /// printed S.No within the roster, both on-screen and in the PDF.
  order Int @default(0)

  roster Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rosterId, memberId])
  @@index([rosterId])
  @@map("roster_scores")
}

// ---------------------------------------------------------------------------
// Marketing module (2026-09-16 client brief) — social media content
// scheduling & publishing. Built as DIRECT integration against each
// platform's own official API (Instagram/Facebook Graph API, YouTube Data
// API v3, Pinterest API v5) rather than a third-party aggregator (Ayrshare
// etc.) — the client explicitly chose to avoid recurring aggregator fees,
// and per docs/ARCHITECTURE.md's verified research, Meta and Google both
// offer a low-friction path (no App Review/Business Verification) for a
// single organization posting only to its own accounts; only Pinterest
// requires a one-time review.
//
// Batch 1 (this change) ships the schema + the admin UI for upload,
// library, scheduling, calendar, and history — PlatformConnection exists now
// so Connected Accounts has something real to render ("Not Connected"
// everywhere), but its OAuth flow and token fields are only populated once
// Batch 2 (developer-app registration + OAuth connect) lands. Batch 3 adds
// the actual cron-driven publish worker — ScheduledPost rows created before
// then persist as real schedule intent but nothing fires yet.
// ---------------------------------------------------------------------------

enum MarketingPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  PINTEREST
}

/// The video uploaded once (brief §4 — "upload the video only once"),
/// reused across every platform-specific ScheduledPost. Deliberately no
/// per-platform copy of the file — every ScheduledPost.content points at
/// the same R2 object.
model MarketingContent {
  id           String  @id @default(cuid())
  title        String
  videoUrl     String
  thumbnailUrl String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledPosts ScheduledPost[]

  @@map("marketing_content")
}

enum PlatformConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  EXPIRED
  ERROR
}

/// One row per platform (not per social account — brief only asks to
/// connect BWF's own single account per platform). Token fields stay null
/// until Batch 2's OAuth flow populates them; encrypted at rest once that
/// lands (see the Batch 2 notes in docs/ARCHITECTURE.md) — never logged,
/// never sent to the client.
model PlatformConnection {
  id       String                   @id @default(cuid())
  platform MarketingPlatform        @unique
  status   PlatformConnectionStatus @default(NOT_CONNECTED)

  /// Display-only — e.g. the connected IG handle / FB Page name / YouTube
  /// channel name / Pinterest account name, so the admin UI can show what's
  /// connected without a live API call on every page load.
  accountName String?
  /// The platform-side id (IG user id / Page id / channel id / Pinterest
  /// user id) the stored tokens are actually scoped to.
  accountId   String?

  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  lastError   String?
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt

  scheduledPosts ScheduledPost[]

  @@map("platform_connections")
}

enum ScheduledPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ACTION_REQUIRED
}

/// One row per (content, platform) — brief §6 is explicit that caption,
/// title, and publishing time must all be independently settable per
/// platform for the same uploaded video, so platform-specific fields live
/// directly here rather than in a shared JSON blob. Only the fields
/// relevant to `platform` are ever read/written for a given row (e.g.
/// `boardId` only matters for PINTEREST) — see src/lib/marketing/fields.ts.
model ScheduledPost {
  id        String           @id @default(cuid())
  contentId String
  /// Restrict, not Cascade — deleting a MarketingContent row must not
  /// silently wipe out real Publishing History for it (same "referenced
  /// parent can't be deleted out from under its children" pattern as
  /// Company/Member — see src/app/admin/(dashboard)/marketing/actions.ts's
  /// delete guard).
  content   MarketingContent @relation(fields: [contentId], references: [id], onDelete: Restrict)

  platform     MarketingPlatform
  connectionId String?
  connection   PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  status ScheduledPostStatus @default(DRAFT)

  /// Instagram/Facebook caption, YouTube description, or Pinterest
  /// description — one field, platform-appropriate label in the UI.
  caption         String?
  hashtags        String?
  /// YouTube video title, or Pinterest pin title.
  title           String?
  /// Pinterest only — the Pin's destination link.
  destinationLink String?
  /// Pinterest only — which board to pin to.
  boardId         String?
  boardName       String?

  /// Stored in UTC; the admin UI collects and displays this in IST (brief
  /// §7 — "All times should default to IST, with the timezone clearly
  /// displayed") via a fixed +05:30 offset conversion, not a timezone
  /// library — IST has no DST, so this doesn't need one.
  scheduledFor DateTime

  publishedUrl String?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts PublishAttempt[]

  @@index([status, scheduledFor])
  @@index([contentId])
  @@map("scheduled_posts")
}

enum PublishAttemptResult {
  SUCCESS
  FAILURE
}

/// Audit trail for every real publish attempt (Batch 3's worker) — exists
/// so a retry after a failure or a server interruption can check "did this
/// already succeed?" before calling the platform API again (brief §8:
/// "must prevent duplicate publishing"), and so Publishing History has a
/// real per-attempt error message to show, not just the post's current
/// (possibly stale) status.
model PublishAttempt {
  id              String        @id @default(cuid())
  scheduledPostId String
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  result       PublishAttemptResult
  errorMessage String?
  publishedUrl String?

  attemptedAt DateTime @default(now())

  @@index([scheduledPostId])
  @@map("publish_attempts")
}
