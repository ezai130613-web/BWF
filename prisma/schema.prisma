// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 2 — auth / RBAC / admin foundation.
//
// Member, Company, Chapter, Category, and every other business entity from
// the brief's §13 model list belong to their own phases (3+) and are NOT
// added here yet — see docs/PHASES.md. Role rows for CHAPTER_ADMIN and
// MEMBER are seeded now as reference data (the taxonomy is known), but the
// scoping needed to actually enforce "Chapter Admin can only access their
// assigned chapter" (brief §11) is added alongside the Chapter model in
// Phase 3, not guessed at here.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id       String     @id @default(cuid())
  email    String     @unique
  name     String
  password String
  status   UserStatus @default(ACTIVE)

  /// Bumped to invalidate every JWT session already issued to this user
  /// (e.g. on password change or an admin-initiated "sign out everywhere").
  sessionVersion Int @default(0)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  otpChallenges OtpChallenge[]
  auditLogs     AuditLog[]

  /// Set only for a User whose role is MEMBER (brief §12) — the Member
  /// profile this login account belongs to. Nullable because most Users
  /// are admins with no Member row at all.
  memberAccount     Member?
  reviewedRevisions MemberProfileRevision[]
  reviewedArticles  Blog[]

  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  /// Stable machine key — SUPER_ADMIN, CENTRAL_ADMIN, CHAPTER_ADMIN, MEMBER.
  key         String  @unique
  label       String
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  /// e.g. "users:manage", "roles:manage", "audit_log:view".
  key         String  @unique
  label       String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  /// Only meaningful when role.key == "CHAPTER_ADMIN" — the chapter this
  /// assignment is scoped to (brief §11: "Chapter Admin can only access
  /// their assigned chapter"). Null for global roles (Super Admin, Central
  /// Admin). This is the scoping mechanism flagged as deferred to Phase 3
  /// in the Phase 2 notes, now that Chapter exists.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model OtpChallenge {
  id       String @id @default(cuid())
  userId   String
  codeHash String

  /// Room for PASSWORD_RESET etc. later without a new table.
  purpose String @default("LOGIN")

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_challenges")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  /// e.g. "user.login", "user.created", "role.assigned".
  action   String
  entity   String?
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3 — chapters, companies, members, categories.
//
// MemberProfile from the brief's §13 list is deliberately NOT a separate
// table yet — its whole reason to exist is the pending-revision workflow
// for member-submitted edits (§20), which only matters once members can log
// in and edit their own profile (Phase 11). Splitting it out now, before
// that workflow exists, would just be structure with no behavior behind it.
// Profile fields live directly on Member for now; revisit if Phase 11
// needs the split.
// ---------------------------------------------------------------------------

enum ChapterStatus {
  /// Exists in the admin system, not shown publicly, not accepting members
  /// yet — brief §16: "Upcoming chapters may exist internally... without
  /// being publicly displayed."
  DRAFT
  /// User request (2026-09-09) — publicly visible and browsable (chapters
  /// listing, homepage grid, its own detail page), but not yet accepting
  /// members/visitors/applications: shown as "Launching Soon" rather than
  /// hidden like DRAFT. Deliberately excluded from every functional
  /// chapter-selection context (Visit/Apply/Members-filter/Feedback
  /// dropdowns) — only the two public browsing listings + its own detail
  /// page opt into showing it.
  COMING_SOON
  ACTIVE
  ARCHIVED
}

model Chapter {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  location    String?
  status      ChapterStatus @default(DRAFT)

  meetingSchedule String?
  meetingVenue    String?
  meetingAddress  String?
  googleMapsUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          Member[]
  leadership       ChapterLeadership[]
  chapterAdmins    UserRole[]
  testimonials     Testimonial[]
  feedback         Feedback[]
  applications     MembershipApplication[]
  meetings         Meeting[]
  events           Event[]
  visitors         Visitor[]
  reportRecipients WeeklyReportRecipient[]
  leads            Lead[]
  chiefGuests      ChiefGuest[]

  @@map("chapters")
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      Member[]
  applications MembershipApplication[]
  visitors     Visitor[]
  leads        Lead[]

  @@map("categories")
}

model Company {
  id          String  @id @default(cuid())
  name        String
  description String?
  website     String?
  logoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]

  @@map("companies")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Member {
  id          String       @id @default(cuid())
  /// Public profile URL: /members/{slug}. Generated from name at creation
  /// (see slugify() in members/actions.ts); stable afterwards even if the
  /// name is later edited, so published links never break.
  slug        String       @unique
  name        String
  designation String?
  bio         String?
  email       String?
  phone       String?
  status      MemberStatus @default(ACTIVE)

  // --- Public profile content (brief §19) — describes THIS member's own
  // specialisation, which can differ from another member at the same
  // Company (brief §14's example: two reps of one company, different
  // categories/chapters). Deliberately plain text fields, not a normalized
  // sub-schema — "services" etc. are freeform lists an admin types in, not
  // structured data the platform needs to query or filter on individually.
  services        String?
  specialisations String?
  usp             String?
  yearsInBusiness Int?
  areasServed     String?
  certifications  String?
  majorProjects   String?
  clientele       String?

  // --- Contact (public, per brief §19 "Public contact details may be displayed") ---
  whatsapp      String?
  website       String?
  address       String?
  googleMapsUrl String?

  // --- Social (brief §19 — "Other approved links" deferred; add if a real need shows up) ---
  instagramUrl String?
  linkedinUrl  String?
  facebookUrl  String?

  // --- Media — URL fields only until object storage (R2) is wired up; no
  // upload UI yet. videoUrl is expected to be a direct file or an approved
  // Google Drive link per brief §19/§47 (YouTube/Instagram embeds are
  // explicitly disallowed there) — not enforced at the schema level since
  // that's a content-moderation judgment call for whoever fills it in.
  photoUrl    String?
  brochureUrl String?
  videoUrl    String?

  // --- Phase 17 — photo/video galleries, each a JSON array of
  // { url: string, caption?: string }. Same shape/precedent as Blog.faq —
  // an ordered list of small records edited inside this one record's form,
  // not a separate child table (no per-parent relational child-row CRUD
  // exists anywhere else in this schema either).
  photos Json?
  videos Json?

  /// Phase 11 — set once an admin grants this member portal login access
  /// (brief §12: "Members eventually receive login access"). Null until
  /// then; a Member can exist for years with no login, same as it did in
  /// Phases 3-10. Nothing about editing/exclusivity/approval logic depends
  /// on this being set.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId  String
  chapterId  String
  categoryId String

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chapter  Chapter  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The category-exclusivity enforcement (brief §15 — CRITICAL rule).
  /// Set to "{chapterId}:{categoryId}" only while status == ACTIVE, and to
  /// null otherwise (see src/lib/members/slot.ts). Because SQL unique
  /// constraints treat every NULL as distinct, this gives a real database-
  /// level guarantee that at most one ACTIVE member can occupy a given
  /// chapter+category pair — not just a check in application code that a
  /// race condition could slip past. Prisma's schema DSL has no portable
  /// way to express a *partial* unique index directly, so this computed-
  /// column pattern is the standard workaround.
  activeSlotKey String? @unique

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadershipRoles   ChapterLeadership[]
  authorProfile     Author?
  fromApplication   MembershipApplication?
  referredVisitors  Visitor[]               @relation("VisitorReferrals")
  profileRevisions  MemberProfileRevision[]
  leads             Lead[]
  submittedArticles Blog[]
  testimonials      Testimonial[]

  // BWF App in-house build (2026-09-09) — see docs comment above the
  // Referral/ThankYouSlip models below for the full picture.
  referralsGiven        Referral[]     @relation("ReferralGiven")
  referralsReceived     Referral[]     @relation("ReferralReceived")
  thankYouSlipsGiven    ThankYouSlip[] @relation("ThankYouSlipGiven")
  thankYouSlipsReceived ThankYouSlip[] @relation("ThankYouSlipReceived")
  oneToOnesRecorded     OneToOne[]     @relation("OneToOneRecordedBy")
  oneToOnesWith         OneToOne[]     @relation("OneToOneWith")
  powerDatesHosted      PowerDate[]    @relation("PowerDateHost")
  powerDatesJoined      PowerDate[]    @relation("PowerDateParticipant")
  conclavesOrganized    Conclave[]              @relation("ConclaveOrganizer")
  conclaveParticipation ConclaveParticipant[]   @relation("ConclaveParticipation")

  // Phase 14 — Postgres doesn't auto-index FK scalar columns; these three
  // are filtered/counted against constantly (directory search, dashboard
  // metrics, exports, chapter-availability computation).
  @@index([chapterId])
  @@index([categoryId])
  @@index([companyId])
  @@map("members")
}

// ---------------------------------------------------------------------------
// Phase 11 — member login + profile edit approval workflow (brief §12/§20).
//
// MemberProfile is still deliberately not split out (the Phase 3/4 note said
// "revisit if Phase 11 needs the split" — it doesn't). A member-submitted
// edit isn't a second copy of the profile; it's a proposed delta that either
// gets applied to the one real Member row or discarded. Storing it as a JSON
// snapshot of proposed field values (same tradeoff as Blog.faq/
// AuditLog.metadata already made) is simpler than mirroring every editable
// column into a parallel table for content that's rejected as often as
// approved.
// ---------------------------------------------------------------------------

enum MemberProfileRevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberProfileRevision {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Proposed values for the editable-profile-field set (see
  /// src/lib/members/profile-fields.ts) — the same fields an admin can edit
  /// directly, submitted by the member instead and held for review. Never
  /// applied to Member until an admin approves it (brief §20: "Members must
  /// NOT directly publish profile changes").
  changes Json

  status MemberProfileRevisionStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([memberId, status])
  @@map("member_profile_revisions")
}

model ChapterLeadershipRole {
  id    String @id @default(cuid())
  /// e.g. PRESIDENT, VICE_PRESIDENT, SECRETARY, COORDINATOR — admin-
  /// manageable so new role types can be added without a code change
  /// (brief §22: "Do not hardcode leadership roles").
  key   String @unique
  label String

  assignments ChapterLeadership[]

  @@map("chapter_leadership_roles")
}

model ChapterLeadership {
  id        String @id @default(cuid())
  chapterId String
  memberId  String
  roleId    String

  chapter Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  member  Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role    ChapterLeadershipRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  startedAt DateTime @default(now())

  @@unique([chapterId, roleId, memberId])
  @@map("chapter_leadership")
}

// ---------------------------------------------------------------------------
// Phase 5 — blog / content management + SEO/AEO/GEO (brief §28-32).
//
// The member-initiated submission workflow from brief §31 ("member submits
// article") can't be fully wired up until member login exists (Phase 11) —
// Blog.authorId already supports linking a post to a Member-backed Author
// now, so hooking up self-service submission later is additive, not a
// restructure. For this phase, admin creates/edits everything directly.
// ---------------------------------------------------------------------------

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Null on every admin-authored post — set only when a member submitted it
/// (brief §31, backlog #21). Mirrors MemberProfileRevisionStatus's 3-state
/// shape, kept as its own enum rather than reusing that one since a Blog is
/// a real published entity being reviewed, not a JSON delta being applied.
enum BlogSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Author {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  bio      String?
  photoUrl String?

  /// Set when this author IS a BWF member (brief §32) — null for BWF Team,
  /// guest contributors, or agency team authors who aren't members.
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  posts Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

model BlogCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  posts Blog[]

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts Blog[]

  @@map("blog_tags")
}

model Blog {
  id      String     @id @default(cuid())
  title   String
  slug    String     @unique
  excerpt String?
  /// Markdown — rendered server-side via `marked` (src/lib/blog/render.ts).
  /// Trusted admin-authored content; the member-submission path (brief §31,
  /// backlog #21) stays behind admin approval before a post can reach
  /// PUBLISHED, so this never renders unreviewed user input.
  content String
  status  BlogStatus @default(DRAFT)

  /// Brief §31 — set when a member submitted this post; null for every
  /// admin-authored one. `submissionStatus` starts PENDING and only ever
  /// moves forward once (see admin/blogs/actions.ts) — approving is just
  /// the normal edit-and-save flow (brief's "Edited" and "Approved" are the
  /// same code path, same precedent as MemberProfileRevision's review
  /// action), rejecting is its own explicit action.
  submittedByMemberId String?
  submittedByMember   Member?               @relation(fields: [submittedByMemberId], references: [id], onDelete: SetNull)
  submissionStatus    BlogSubmissionStatus?
  reviewedById        String?
  reviewedBy          User?                 @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes         String?
  reviewedAt          DateTime?

  /// FAQ entries for AEO/GEO (brief §29) — [{ question, answer }, ...].
  /// Rendered as an on-page FAQ section and FAQPage structured data.
  faq Json?

  featuredImageUrl String?

  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?

  authorId   String
  categoryId String

  author   Author       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags     BlogTag[]

  scheduledAt DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([submissionStatus])
  @@map("blogs")
}

// ---------------------------------------------------------------------------
// Phase 6 — testimonials + feedback + website content CMS (brief §33/§34/§62).
// Three genuinely different visibility models living in one phase: a
// testimonial is public once approved, feedback is never public (Super
// Admin only, brief §34 is explicit about this), and content blocks are
// always public but only editable by admin — worth keeping straight when
// touching any of these three.
// ---------------------------------------------------------------------------

enum TestimonialType {
  MEMBER
  VISITOR
  CLIENT
  VIDEO
  SUCCESS_STORY
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id      String            @id @default(cuid())
  name    String
  company String?
  role    String?
  content String
  type    TestimonialType   @default(MEMBER)
  status  TestimonialStatus @default(PENDING)

  imageUrl String?
  videoUrl String?
  rating   Int?

  /// True once whoever submitted this agreed to public display — brief §58:
  /// "Do not pre-check consent boxes." Checked at the point of approval, not
  /// just at submission, so admin-entered testimonials must set it deliberately too.
  consent  Boolean @default(false)
  featured Boolean @default(false)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  /// Phase 17 — links a testimonial/success story to the specific Member
  /// it's about, mirroring the existing chapterId/chapter pair exactly.
  /// Nullable: a testimonial can still be chapter-only (or neither) same as
  /// before this field existed.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured])
  @@index([chapterId])
  @@index([memberId])
  @@map("testimonials")
}

enum FeedbackType {
  MEETING
  EVENT
  MANAGEMENT
  GENERAL
}

model Feedback {
  id      String       @id @default(cuid())
  type    FeedbackType @default(GENERAL)
  name    String?
  email   String?
  message String

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("feedback")
}

/// Named, admin-editable copy blocks (brief §62) — deliberately NOT a full
/// page builder ("do NOT make every pixel editable"). Each row is one piece
/// of copy identified by a stable key (e.g. "about.intro",
/// "contact.phone") that a page reads at render time instead of hardcoding
/// the string. `section` is purely for grouping the admin UI.
model WebsiteContent {
  key     String  @id
  label   String
  section String
  value   String?

  updatedAt DateTime @updatedAt

  @@map("website_content")
}

model SiteFaq {
  id       String  @id @default(cuid())
  question String
  answer   String
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_faqs")
}

// ---------------------------------------------------------------------------
// Phase 7 — membership application + category availability + waiting list
// (brief §16-17). The applicant's company doesn't exist as a Company record
// yet at submission time — companyName is plain text here, and a real
// Company row only gets created/matched when admin converts an approved
// application into a Member (see applications/actions.ts).
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  MEETING_SCHEDULED
  APPROVED_IN_PRINCIPLE
  WAITING_FOR_PAYMENT
  PAID
  REJECTED
  WAITLISTED
}

model MembershipApplication {
  id              String            @id @default(cuid())
  name            String
  phone           String
  email           String
  companyName     String
  designation     String?
  yearsInBusiness Int?
  referralSource  String?
  companyInfo     String?
  status          ApplicationStatus @default(NEW)

  /// User request (2026-09-09) — membership payment proof, same optional
  /// "verify after, don't hard-gate submission" pattern as Visitor's own
  /// paymentScreenshotUrl.
  paymentScreenshotUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Null when the applicant joined the waiting list because every active
  /// chapter's slot for their category was already taken (brief §16) — an
  /// admin assigns a chapter (possibly a DRAFT one not yet public) once one
  /// opens up, via the application's own admin page.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  /// Set once an admin creates the real Member record (brief §17 step 7 —
  /// approval alone must never auto-create a public member). Keeps the
  /// Visitor → Applicant → Member lineage the brief asks for (§23) visible
  /// from the application side too.
  convertedMemberId String? @unique
  convertedMember   Member? @relation(fields: [convertedMemberId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([categoryId])
  @@map("membership_applications")
}

// ---------------------------------------------------------------------------
// Phase 8 — visitor registration + meetings + events (brief §21/§23-26).
//
// Visitor and VisitorRegistration are listed as separate entities in the
// brief's §13 model list, but every field brief §23 actually asks a visitor
// to submit — name/phone/email/company/category/chapter/meeting/referring
// member — IS the registration. Splitting "person" from "one specific
// registration" only earns its cost once the same person visits more than
// once and that history needs to be reconciled, which isn't asked for yet.
// One Visitor row per registration, same simplicity call as Member vs
// MemberProfile in Phase 3 — revisit if repeat-visitor deduplication
// becomes a real requirement.
// ---------------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id    String @id @default(cuid())
  title String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  startsAt      DateTime
  venue         String?
  address       String?
  googleMapsUrl String?
  agenda        String?
  speaker       String?
  description   String?

  visitorRegistrationEnabled Boolean       @default(true)
  status                     MeetingStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitors Visitor[]

  @@index([chapterId, startsAt])
  @@map("meetings")
}

enum EventType {
  CHAPTER_MEETING
  NETWORKING_EVENT
  SEMINAR
  EXHIBITION
  CHAPTER_LAUNCH
  SPECIAL_EVENT
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  eventType   EventType @default(SPECIAL_EVENT)

  /// Null = a site-wide/global event, not tied to one chapter (brief §26:
  /// "Chapter or Global").
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  startsAt             DateTime
  venue                String?
  imageUrl             String?
  registrationEnabled  Boolean     @default(true)
  capacity             Int?
  registrationDeadline DateTime?
  status               EventStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitors Visitor[]

  @@index([chapterId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Phase 9 — reporting, exports & weekly report configuration (brief §39,
// §44-46). The export itself (Excel/CSV/PDF of the same Name/Category/Phone/
// Membership-Status fields, on demand or "weekly") needs no schema of its
// own — it's a read against Member. What DOES need storage is brief §46's
// explicit "recipients should be configurable... do not hardcode recipients"
// and "schedule should be configurable" — WeeklyReportRecipient/Settings
// exist for exactly that. Actually emailing them out automatically is
// deliberately NOT built this phase: every other transactional email this
// project has needed (visitor confirmations in Phase 8, application
// confirmations in Phase 7) was explicitly deferred to Phase 13 ("Email /
// Notification Automation") even when, like this one, it was closely tied to
// the phase that introduced the underlying data — see docs/PHASES.md. Weekly
// Reports gets the same treatment: the config is real and admin-editable now,
// Phase 13 wires the actual scheduled send on top of it.
// ---------------------------------------------------------------------------

enum WeeklyReportScope {
  MASTER
  CHAPTER
}

model WeeklyReportRecipient {
  id    String            @id @default(cuid())
  email String
  scope WeeklyReportScope @default(MASTER)

  /// Only meaningful when scope == CHAPTER.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  /// Backlog #26 — per-recipient column preference, mirroring the same
  /// "include Chapter & Company" checkbox /admin/exports already offers for
  /// an on-demand export (brief §44's "must not alter requested export
  /// unless selected" applies the same way here: off by default).
  includeExtraColumns Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("weekly_report_recipients")
}

/// Singleton row (id is always "singleton") — the one configurable schedule
/// brief §46 asks for. `isEnabled` stays false until Phase 13 actually wires
/// a sender on top of this; flipping it true today would have no effect.
model WeeklyReportSettings {
  id        String  @id @default("singleton")
  isEnabled Boolean @default(false)
  /// 0 = Sunday .. 6 = Saturday.
  dayOfWeek Int     @default(1)

  updatedAt DateTime @updatedAt

  @@map("weekly_report_settings")
}

enum VisitorStatus {
  REGISTERED
  ATTENDED
  FOLLOW_UP_REQUIRED
  INTERESTED_IN_MEMBERSHIP
  APPLICATION_SUBMITTED
  CONVERTED
  NOT_INTERESTED
}

enum VisitorPurpose {
  PROSPECTIVE_MEMBER
  END_CONSUMER
  CHIEF_GUEST
}

enum VisitorMeetingOption {
  MEETING_ONLY
  MEETING_BREAKFAST
}

model Visitor {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String
  company     String?
  designation String?
  status      VisitorStatus @default(REGISTERED)

  /// Client correction spec (2026-09-09) §40 — null for event registrations
  /// (VisitorRegisterForm hides this whole block when `eventId` is set,
  /// since visitor pricing/purpose is specifically about chapter meetings,
  /// not events, which the spec says "may be separate").
  purposeOfVisit  VisitorPurpose?
  meetingOption   VisitorMeetingOption?
  /// R2 URL of the visitor's uploaded payment screenshot — optional (§41's
  /// confirmation copy says "our team will verify your registration and
  /// payment", i.e. verification happens after, not a hard submit gate).
  paymentScreenshotUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  /// Visitors are NOT required to belong to an open category (brief §23),
  /// so unlike Member there is no activeSlotKey / exclusivity check here.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  referringMemberId String?
  referringMember   Member? @relation("VisitorReferrals", fields: [referringMemberId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([categoryId])
  @@map("visitors")
}

// ---------------------------------------------------------------------------
// Phase 12 — Ask BWF RAG chatbot (brief §36-38).
//
// Retrieval is plain structured Prisma queries against existing public
// content (Chapter/Category/Member/Blog/SiteFaq/WebsiteContent) — not vector
// embeddings — per the confirmed approach, so no new infra (pgvector, an
// embedding pipeline) is needed. ChatbotLead is deliberately a narrow model
// (name/phone/email/requirement only, brief's own "avoid unnecessarily large
// forms" pattern) — it's one lead SOURCE, not the general Leads system (brief
// §35), which still has no phase of its own; see docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------

enum ChatbotAccessMode {
  PUBLIC
  LOGIN_REQUIRED
  LIMITED_FREE_QUESTIONS
}

/// Singleton row (id is always "singleton") — brief §37: "Admin should
/// eventually be able to choose configuration." isEnabled defaults false,
/// same safe-default-off pattern as WeeklyReportSettings — the widget stays
/// entirely absent from the public site until an admin turns it on.
model ChatbotSettings {
  id                 String            @id @default("singleton")
  isEnabled          Boolean           @default(false)
  accessMode         ChatbotAccessMode @default(PUBLIC)
  /// Only meaningful when accessMode == LIMITED_FREE_QUESTIONS.
  freeQuestionsLimit Int               @default(5)

  updatedAt DateTime @updatedAt

  @@map("chatbot_settings")
}

/// One row per browser session (client-generated sessionId, not tied to a
/// logged-in user). `messages` is a JSON array of {role, content, at} —
/// mirrors the Blog.faq/MemberProfileRevision.changes precedent for small,
/// short-lived structured data that doesn't earn its own table.
model ChatbotConversation {
  id        String  @id @default(cuid())
  sessionId String  @unique
  /// Set when the visitor was signed in (member or admin) at message time —
  /// not a hard requirement, just recorded when known.
  userId    String?
  messages  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads ChatbotLead[]

  @@map("chatbot_conversations")
}

enum ChatbotLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}

model ChatbotLead {
  id             String               @id @default(cuid())
  conversationId String?
  conversation   ChatbotConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  name        String
  phone       String
  email       String?
  requirement String

  status ChatbotLeadStatus @default(NEW)
  /// Free-text follow-up notes — including, if relevant, which member/
  /// chapter/category this lead was matched to. Deliberately not separate
  /// FK columns (see the Phase 12 header comment above).
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("chatbot_leads")
}

// ---------------------------------------------------------------------------
// Phase 14 — production security review (brief §55): rate limiting / form
// abuse protection. Postgres-backed rather than a new external service
// (Upstash/Redis would need real credentials this project doesn't have) —
// see src/lib/rate-limit.ts. Every FK index added elsewhere in this schema
// this phase (Member/Visitor/MembershipApplication/Blog/Event/Testimonial)
// is also part of this phase, not called out with its own block since it's
// additive to existing models rather than new ones.
// ---------------------------------------------------------------------------

model RateLimitHit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_hits")
}

// ---------------------------------------------------------------------------
// Leads system (brief §35) — a rollup across every lead-generating touchpoint
// on the site, given its own phase/home here (backlog item #17; the brief's
// own Phase Structure table §70 never assigned it one). This does NOT
// replace any existing specific record — MembershipApplication, Visitor, and
// ChatbotLead each keep their own detailed model, admin page, and workflow
// exactly as before. `Lead` is purely the cross-source summary brief §35's
// field list and brief §39's dashboard "New leads" tile actually describe:
// every one of those flows additionally writes one Lead row here (see
// src/lib/leads/record.ts) alongside doing whatever it already did.
//
// Two of the brief's seven listed sources — "Member profile enquiry" and
// "Contact form" — have no real capture point on the site yet (a member's
// public contact block is a plain mailto/tel/WhatsApp link a visitor leaves
// the site to use, not a form with data to record; no general Contact Us
// page exists at all). Modeled as real LeadSource values so nothing about
// the schema needs to change whenever those forms are eventually built, but
// nothing populates them yet — see docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------

enum LeadSource {
  MEMBER_PROFILE_ENQUIRY
  CONTACT_FORM
  CHATBOT
  MEMBERSHIP_ENQUIRY
  VISITOR_REGISTRATION
  EVENT_REGISTRATION
  CATEGORY_WAITLIST
}

/// Mirrors ChatbotLeadStatus's own 4-state lifecycle (brief §35's "Future
/// system should track whether lead became business" is just CONVERTED —
/// no separate boolean needed for the same fact).
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}

model Lead {
  id          String     @id @default(cuid())
  source      LeadSource
  name        String
  phone       String
  email       String?
  requirement String?

  /// The member a lead is "involved" with, per brief §35's field list — set
  /// when known (e.g. who referred a visitor); most sources don't have one.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// Null for sources with no chapter of their own (chatbot, a waitlisted
  /// membership enquiry with no chapter assigned yet) — deliberately, not a
  /// missing-data bug. A Chapter Admin's admin view (requireChapterAccess)
  /// can only ever show leads with a real chapterId; a null-chapter lead is
  /// visible only to Central/Super Admin via the blanket leads:manage
  /// permission, same visibility rule ChatbotLead's own page already used.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status LeadStatus @default(NEW)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([chapterId])
  @@index([source])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Client correction spec (2026-09-09) — "ADDITIONAL REQUIREMENT — CHIEF
// GUESTS" + backlog #21 ("give Leads-style Chief Guest DB an actual home").
// No fixed limit on how many can be added (spec is explicit about this) —
// plain unbounded table + pagination-free carousel query is enough at any
// realistic scale for a chapter-based community.
// ---------------------------------------------------------------------------

model ChiefGuest {
  id           String  @id @default(cuid())
  name         String
  photoUrl     String?
  company      String?
  designation  String?
  description  String?

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  visitedAt DateTime?

  isPublished Boolean @default(true)

  /// Explicit admin-set position (spec: "Display Order — Admin configurable").
  /// Null means "let recency decide" — see the homepage carousel's query:
  /// `orderBy: [{ displayOrder: "asc" }, { visitedAt: "desc" }, { createdAt: "desc" }]`.
  /// Rows with a real number sort first (Prisma puts NULLs last in `asc`
  /// order by default), everything else falls back to "most recently
  /// visited first" per the spec's own default-order rule, with no extra
  /// code needed to keep newly-added guests floating to the top.
  displayOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([isPublished])
  @@map("chief_guests")
}

// ---------------------------------------------------------------------------
// BWF App in-house build (2026-09-09, greenlit after the client corrections
// pass — see memory note [[bwf-app-inhouse]]). Foundation piece: Referral +
// Thank You Slip, the two activity types every later piece (points, weekly/
// periodic reports, detailed reports) aggregates over. Terminology and
// meaning must stay exactly what's already live on /chapters (client
// correction spec's own BWF Terminology section) — do not invent different
// definitions here.
//
// Both models are member-self-reported activity logs, written directly by
// the recording member — deliberately NOT routed through an admin-approval
// queue the way MemberProfileRevision/Blog submissions are. A referral or
// Thank You Slip is a private business record between two members, not
// public-facing content a moderator needs to gate.
// ---------------------------------------------------------------------------

enum ReferralType {
  /// You connect another BWF member with someone from your own network.
  OUTSIDE
  /// You personally buy the other member's product/service.
  SELF
}

model Referral {
  id          String       @id @default(cuid())
  type        ReferralType
  description String?

  /// The member who gave/passed the referral.
  fromMemberId String
  fromMember   Member @relation("ReferralGiven", fields: [fromMemberId], references: [id], onDelete: Restrict)

  /// The member the referral/opportunity was passed to.
  toMemberId String
  toMember   Member @relation("ReferralReceived", fields: [toMemberId], references: [id], onDelete: Restrict)

  thankYouSlips ThankYouSlip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("referrals")
}

/// Records business successfully generated from a referral (brief's own
/// example: Member A refers Member B to HR Groups; HR Groups places a real
/// order with Member B; Member B — the one who actually received the
/// business — records a Thank You Slip TO Member A, the referral's giver).
model ThankYouSlip {
  id          String  @id @default(cuid())
  /// Plain rupee integer, same "store the real number, format at render
  /// time" convention as WebsiteContent's stats.businessGeneratedInr.
  amountInr   Int
  description String?

  /// The member recording this — who received the business and is thanking
  /// the referral's giver.
  fromMemberId String
  fromMember   Member @relation("ThankYouSlipGiven", fields: [fromMemberId], references: [id], onDelete: Restrict)

  /// The member being thanked — who gave the original referral.
  toMemberId String
  toMember   Member @relation("ThankYouSlipReceived", fields: [toMemberId], references: [id], onDelete: Restrict)

  /// Optional link back to the Referral this business came from — not
  /// required, since a member might record a Thank You Slip for older
  /// activity that predates this system.
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([referralId])
  @@map("thank_you_slips")
}

// ---------------------------------------------------------------------------
// BWF App in-house build, continued — One-to-One, Power Date, Conclave.
// Same member-self-reported (no admin-approval queue), same terminology as
// what's already live on /chapters — do not redefine these.
// ---------------------------------------------------------------------------

/// Two BWF members meeting to understand each other deeply — symmetric (no
/// direction, unlike Referral/ThankYouSlip), so `memberId` is just whoever
/// recorded it and `withMemberId` the other person, not a "from/to" of value.
model OneToOne {
  id    String  @id @default(cuid())
  notes String?
  metAt DateTime @default(now())

  memberId String
  member   Member @relation("OneToOneRecordedBy", fields: [memberId], references: [id], onDelete: Restrict)

  withMemberId String
  withMember   Member @relation("OneToOneWith", fields: [withMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([withMemberId])
  @@map("one_to_ones")
}

/// A BWF member (the host) takes one fellow member to meet the host's own
/// external connection. "One or more fellow members" per the brief — taking
/// several companions to the same external meeting is recorded as one
/// PowerDate row per companion, same simplification tradeoff as Member vs
/// MemberProfile (no join table for what's realistically almost always 1).
model PowerDate {
  id                       String  @id @default(cuid())
  externalContactName     String
  externalContactCompany  String?
  notes                    String?
  metAt                    DateTime @default(now())

  hostMemberId String
  hostMember   Member @relation("PowerDateHost", fields: [hostMemberId], references: [id], onDelete: Restrict)

  participantMemberId String
  participantMember   Member @relation("PowerDateParticipant", fields: [participantMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostMemberId])
  @@index([participantMemberId])
  @@map("power_dates")
}

/// 3+ BWF members meeting together — genuinely needs a real participant
/// list (unlike PowerDate's near-always-one companion), so this gets an
/// actual join table rather than a JSON array: points/reports later need to
/// query "every Conclave a given member was part of" relationally, which a
/// JSON array of ids can't do cleanly (no Prisma include/filter on it).
model Conclave {
  id       String  @id @default(cuid())
  location String?
  notes    String?
  metAt    DateTime @default(now())

  organizedByMemberId String
  organizedByMember   Member @relation("ConclaveOrganizer", fields: [organizedByMemberId], references: [id], onDelete: Restrict)

  participants ConclaveParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizedByMemberId])
  @@map("conclaves")
}

model ConclaveParticipant {
  id String @id @default(cuid())

  conclaveId String
  conclave   Conclave @relation(fields: [conclaveId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation("ConclaveParticipation", fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([conclaveId, memberId])
  @@index([memberId])
  @@map("conclave_participants")
}

// ---------------------------------------------------------------------------
// BWF App in-house build, continued — Points/Scoring (client correction
// spec's "Screenshot 4"). Spec is explicit: "the points allocated to each
// activity must be admin-configurable... do not hard-code the scoring
// values." One row per activity type, seeded at 0 (not fabricated point
// values) — admin sets real numbers via /admin/points-config.
//
// Covers every activity type this app can currently compute for real:
// the 5 self-reported models above, plus VISITOR/CONSUMER/CHIEF_GUEST/
// INDUCTION — all derived from the *existing* public Visitor model
// (referringMemberId + purposeOfVisit + status=CONVERTED), not a new model.
// Spec's remaining list items ("Meeting participation", "Members referred")
// have no underlying data model yet (no attendance-tracking system exists)
// — deliberately left out rather than computed from nothing.
// ---------------------------------------------------------------------------

enum ActivityType {
  REFERRAL
  THANK_YOU_SLIP
  ONE_TO_ONE
  POWER_DATE
  CONCLAVE
  VISITOR
  CONSUMER
  CHIEF_GUEST
  INDUCTION
}

model PointsConfig {
  id           String       @id @default(cuid())
  activityType ActivityType @unique
  points       Int          @default(0)

  updatedAt DateTime @updatedAt

  @@map("points_config")
}
